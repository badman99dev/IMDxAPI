{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "20mb",
        "includeFiles": [
          "app/**/*.py",
          "requirements.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "headers": [
    { "source": "/titles/(.*)/parentsGuide",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400" }] },
    { "source": "/titles/(.*)/certificates",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400" }] },
    { "source": "/titles/(.*)/akas",          "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400" }] },
    { "source": "/titles/(.*)/releaseDates",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400" }] },
    { "source": "/names/(.*)/trivia",         "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400" }] },
    { "source": "/interests(.*)",             "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=86400" }] },

    { "source": "/titles/(.*)/seasons",       "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=3600" }] },
    { "source": "/titles/(.*)/images",        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=3600" }] },
    { "source": "/titles/(.*)/awardNominations", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=3600" }] },
    { "source": "/titles/(.*)/companyCredits", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=3600" }] },
    { "source": "/names/(.*)/images",         "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=3600" }] },
    { "source": "/names/(.*)/relationships",  "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=3600" }] },
    { "source": "/names/(.*)",                "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=3600" }] },
    { "source": "/titles/(.*)/?$",            "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=3600" }] },

    { "source": "/titles/(.*)/credits",       "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }] },
    { "source": "/titles/(.*)/episodes",      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }] },
    { "source": "/titles/(.*)/videos",        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }] },
    { "source": "/titles/(.*)/boxOffice",     "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }] },
    { "source": "/titles:batchGet",           "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }] },
    { "source": "/names/(.*)/filmography",    "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }] },
    { "source": "/names:batchGet",            "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }] },
    { "source": "/titles",                    "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=300" }] },

    { "source": "/chart/starmeter",           "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=60" }] },
    { "source": "/search/titles",             "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=60" }] }
  ]
}
